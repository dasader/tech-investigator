# Required
GEMINI_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://techspec:techspec@db:5432/techspec_db

# Optional
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
OPENALEX_API_KEY=
KCI_API_KEY=
GEMINI_MODEL_COMPLEX=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash
MAX_PAPERS_PER_INDICATOR=30
MIN_CONFIDENCE_SCORE=0.5

# MinIO (S3-compatible storage for PDF reports)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=techspec-pdfs

# Email notifications (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# NOTE: 실제로는 루트 `.env`만 사용됩니다.
# docker-compose.yml의 `env_file: .env`가 compose 파일이 있는 루트 기준이라,
# 거기서 환경변수를 읽어 컨테이너에 주입합니다. 이 파일(backend/.env.example)은
# 과거 잔존이며 일관성을 위해 유지되고 있습니다. 실제 키는 루트 `.env`에 추가하세요.

# Required
GEMINI_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://techspec:techspec@db:5432/techspec_db

# Optional
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
OPENALEX_API_KEY=
KCI_API_KEY=
GEMINI_MODEL_COMPLEX=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
MAX_PAPERS_PER_INDICATOR=30
MIN_CONFIDENCE_SCORE=0.5

# MinIO (S3-compatible storage for PDF reports)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=techspec-pdfs

# Email notifications (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
